# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Your custom OpenAI-compatible provider.
# AI_BASE_URL is the host root; the bot appends /v1/chat/completions.
# Examples:
#   OpenAI:     https://api.openai.com
#   Ollama:     http://localhost:11434
#   OpenRouter: https://openrouter.ai/api
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: path to the editable personality file (default: personality.txt)
# PERSONALITY_FILE=personality.txt

# Optional: log verbosity (default: info,serenity=warn)
# RUST_LOG=info
